# Use este arquivo somente no ambiente local. Nunca o inclua na distribuição.
# Para uso pessoal, preencha apenas as chaves que você possui.
GEMINI_API_KEY=
GROQ_API_KEY=

# Usada exclusivamente por lancar_atualizacao.py na sua máquina de publicação.
GITHUB_TOKEN=

# Nunca coloque estes valores no app distribuído nem neste arquivo com valores reais.
# Antes de publicar as Functions, configure-os no Firebase Secret Manager:
# MERCADOPAGO_ACCESS_TOKEN: Access Token de teste ou produção do Mercado Pago.
# MERCADOPAGO_WEBHOOK_SECRET: assinatura secreta criada em Suas integrações > Webhooks.
# MERCADOPAGO_ENVIRONMENT: "sandbox" para testar e "production" para vendas reais.
# MERCADOPAGO_MONTHLY_PRICE_CENTS: mensalidade em centavos (ex.: R$ 97,00 = 9700).
# Em sandbox, a integração usa automaticamente test@testuser.com como pagador.
